   "source": [
    "## 3. GRID SEARCH\n",
    "\n",
    "Grid Search es una técnica para encontrar los mejores hiperparámetros de un modelo probando todas las combinaciones posibles de un conjunto de valores especificados."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "# 3.1 GRID SEARCH PARA RIDGE\n",
    "# =============================================================================\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"📊 3.1 GRID SEARCH - RIDGE\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "param_grid_ridge = {\n",
    "    'alpha': [0.001, 0.01, 0.1, 1, 10, 100, 1000]\n",
    "}\n",
    "\n",
    "print(f\"🔍 Buscando en {len(param_grid_ridge['alpha'])} valores de α\")\n",
    "\n",
    "grid_ridge = GridSearchCV(\n",
    "    Ridge(),\n",
    "    param_grid_ridge,\n",
    "    cv=5,\n",
    "    scoring='accuracy',\n",
    "    n_jobs=-1,\n",
    "    verbose=1\n",
    ")\n",
    "grid_ridge.fit(X_train_scaled, y_train)\n",
    "\n",
    "print(f\"\\n  ✅ Mejores parámetros: {grid_ridge.best_params_}\")\n",
    "print(f\"  ✅ Mejor score (CV): {grid_ridge.best_score_:.4f}\")\n",
    "print(f\"  ✅ Test score: {grid_ridge.score(X_test_scaled, y_test):.4f}\")\n",
    "\n",
    "# Visualización de resultados\n",
    "results_ridge = pd.DataFrame(grid_ridge.cv_results_)\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.plot(results_ridge['param_alpha'], results_ridge['mean_test_score'], 'o-')\n",
    "plt.xscale('log')\n",
    "plt.xlabel('α (alpha)')\n",
    "plt.ylabel('Mean CV Score')\n",
    "plt.title('Grid Search - Ridge')\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "# 3.2 GRID SEARCH PARA LASSO\n",
    "# =============================================================================\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"📊 3.2 GRID SEARCH - LASSO\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "param_grid_lasso = {\n",
    "    'alpha': [0.001, 0.01, 0.1, 0.5, 1, 2, 5]\n",
    "}\n",
    "\n",
    "print(f\"🔍 Buscando en {len(param_grid_lasso['alpha'])} valores de α\")\n",
    "\n",
    "grid_lasso = GridSearchCV(\n",
    "    Lasso(max_iter=10000),\n",
    "    param_grid_lasso,\n",
    "    cv=5,\n",
    "    scoring='accuracy',\n",
    "    n_jobs=-1,\n",
    "    verbose=1\n",
    ")\n",
    "grid_lasso.fit(X_train_scaled, y_train)\n",
    "\n",
    "print(f\"\\n  ✅ Mejores parámetros: {grid_lasso.best_params_}\")\n",
    "print(f\"  ✅ Mejor score (CV): {grid_lasso.best_score_:.4f}\")\n",
    "print(f\"  ✅ Test score: {grid_lasso.score(X_test_scaled, y_test):.4f}\")\n",
    "\n",
    "# Visualización\n",
    "results_lasso = pd.DataFrame(grid_lasso.cv_results_)\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.plot(results_lasso['param_alpha'], results_lasso['mean_test_score'], 'o-')\n",
    "plt.xscale('log')\n",
    "plt.xlabel('α (alpha)')\n",
    "plt.ylabel('Mean CV Score')\n",
    "plt.title('Grid Search - Lasso')\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
